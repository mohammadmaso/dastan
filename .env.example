# ---------------------------------------------------------------------------
# StoryWriter — environment configuration (copy to .env to override defaults)
# Docker Compose reads this file automatically.
# ---------------------------------------------------------------------------

# --- API / Web ports ---
WEB_PORT=3000
API_PORT=3001

# --- PostgreSQL application state ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=storywriter
POSTGRES_USER=storywriter
POSTGRES_PASSWORD=storywriter

# --- FalkorDB graph memory ---
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_GRAPH=storywriter

# --- Graphiti sidecar ---
MEMORY_URL=http://memory:8000
MEMORY_PORT=8000

# --- Graphiti-style memory configuration ---
# Fallback default for the embedding model used to embed story memory.
# Configurable per-user in Settings (Embeddings section).
MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM (OpenAI-compatible endpoint by default; supports local/self-hosted) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# The browser calls the API same-origin via Next.js's /api rewrite (no CORS).
# This only sets the server-side fallback target when INTERNAL_API_URL is unset
# (e.g. running `pnpm dev` outside Docker with the API on localhost:3001).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side proxy target inside Docker (the api service name).
INTERNAL_API_URL=http://api:3001
