{
  "name": "@storywriter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "check:isolation": "tsx src/memory/isolation.check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.22",
    "@storywriter/types": "workspace:*",
    "ai": "^5.0.52",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
