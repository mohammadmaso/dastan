{
  "name": "storywriter",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered interactive branching storytelling application",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @storywriter/api --filter @storywriter/web dev",
    "dev:api": "pnpm --filter @storywriter/api dev",
    "dev:web": "pnpm --filter @storywriter/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
